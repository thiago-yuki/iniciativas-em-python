import pygame
import sys
import random

pygame.init()

LARGURA = 800
ALTURA = 600
TAMANHO = 20
AMARELO = (255, 255, 0)
AZUL_ESCURO = (0, 0, 139)
PRETO = (0, 0, 0)
BRANCO = (255, 255, 255)

MACAS_POR_NIVEL = 5
VELOCIDADE_INICIAL = 10
AUMENTO_VELOCIDADE = 2

tela = pygame.display.set_mode((LARGURA, ALTURA))
pygame.display.set_caption("Jogo da Cobrinha")
relogio = pygame.time.Clock()

cobra = [
    [400, 300],
    [380, 300],
    [360, 300],
]

velocidade_x = TAMANHO
velocidade_y = 0

fonte = pygame.font.SysFont("comicsans", 35)

comida = [
    random.randrange(0, LARGURA - TAMANHO, TAMANHO),
    random.randrange(0, ALTURA - TAMANHO, TAMANHO),
]

pontos = 0
nivel = 1

rodando = True

while rodando:
    for evento in pygame.event.get():
        if evento.type == pygame.QUIT:
            rodando = False
        elif evento.type == pygame.KEYDOWN:
            if evento.key == pygame.K_UP and velocidade_y == 0:
                velocidade_x, velocidade_y = 0, -TAMANHO
            elif evento.key == pygame.K_DOWN and velocidade_y == 0:
                velocidade_x, velocidade_y = 0, TAMANHO
            elif evento.key == pygame.K_LEFT and velocidade_x == 0:
                velocidade_x, velocidade_y = -TAMANHO, 0
            elif evento.key == pygame.K_RIGHT and velocidade_x == 0:
                velocidade_x, velocidade_y = TAMANHO, 0

    nova_cabeca = [cobra[0][0] + velocidade_x, cobra[0][1] + velocidade_y]
    cobra.insert(0, nova_cabeca)

    if cobra[0] == comida:
        pontos += 1
        nivel = pontos // MACAS_POR_NIVEL + 1
        comida = [
            random.randrange(0, LARGURA - TAMANHO, TAMANHO),
            random.randrange(0, ALTURA - TAMANHO, TAMANHO),
        ]
    else:
        cobra.pop()

    if (cobra[0][0] < 0 or cobra[0][0] >= LARGURA or
            cobra[0][1] < 0 or cobra[0][1] >= ALTURA or
            cobra[0] in cobra[1:]):
        rodando = False

    tela.fill(PRETO)
    for segmento in cobra:
        pygame.draw.rect(tela, AZUL_ESCURO, (segmento[0], segmento[1], TAMANHO, TAMANHO))
    pygame.draw.rect(tela, AMARELO, (comida[0], comida[1], TAMANHO, TAMANHO))
    texto = fonte.render(f"Pontos: {pontos} | Nível: {nivel}", True, BRANCO)
    tela.blit(texto, (10, 10))

    pygame.display.update()

    velocidade = VELOCIDADE_INICIAL + (nivel - 1) * AUMENTO_VELOCIDADE
    relogio.tick(velocidade)

texto = fonte.render(f"Fim de jogo! Pontos: {pontos} | Nível: {nivel}", True, BRANCO)
tela.blit(texto, (LARGURA // 2 - texto.get_width() // 2, ALTURA // 2))
pygame.display.update()
pygame.time.wait(2000)

pygame.quit()
sys.exit()
